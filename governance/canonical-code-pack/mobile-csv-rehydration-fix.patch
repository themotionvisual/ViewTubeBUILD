# ViewTube Visual Time Windows — mobile CSV rehydration regression fix
#
# Target files:
#   src/features/vt-sync-local/adapters/manualImports.ts
#   src/features/vt-sync-local/shell/VtSyncLocalAnalyticsPage.tsx
#
# Goal:
#   Imported CSV rows must remain active while mobile account/channel identity
#   hydrates. Account boot must never replace known-good local CSV state with an
#   empty dataset.
#
# NOTE: This is intentionally a surgical patch/spec rather than a wholesale
# replacement of the two large current branch files.

