# Public web-app environment. This is the only worker URL the browser needs;
# the browser itself continues to call same-origin /api/vt-e1/render/*.
VT_E1_RENDER_SERVICE_URL=https://your-vt-e1-render-worker.example.com
VT_E1_RENDER_SHARED_SECRET=replace-with-a-long-random-secret
VT_E1_RENDER_PUBLIC_ORIGIN=https://viewtube.live
VT_E1_RENDER_PROXY_TIMEOUT_MS=15000

# Render-worker environment. Mount VT_E1_RENDER_DATA_DIR to durable storage.
PORT=3001
VT_E1_RENDER_ORIGIN=https://viewtube.live
VT_E1_RENDER_SHARED_SECRET=replace-with-the-same-long-random-secret
VT_E1_RENDER_DATA_DIR=/var/lib/vt-e1-render
VT_E1_RENDER_PERSISTENT_STORAGE=true
FFMPEG_BIN=ffmpeg
