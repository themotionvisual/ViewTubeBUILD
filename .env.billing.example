# ---------- Billing Server ----------
BILLING_PORT=3000
BILLING_ORIGIN=https://viewtube.live/
ACCOUNT_PUBLIC_ORIGIN=https://viewtube.live/
ACCOUNT_TRUSTED_ORIGINS=https://viewtube.live,https://www.viewtube.live
DATABASE_URL=postgresql://viewtube:REPLACE_ME@127.0.0.1:5432/viewtube
DATABASE_SSL=false
ACCOUNT_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_OR_64_HEX_KEY
GOOGLE_OAUTH_CLIENT_ID=REPLACE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_ME
GOOGLE_OAUTH_REDIRECT_URI=https://viewtube.live/api/account/auth/callback
STRIPE_API_BASE=https://api.stripe.com/v1
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_TRIAL_HOURS=48

# Subscription prices (monthly)
STRIPE_PRICE_CREATOR=price_REPLACE_ME
STRIPE_PRICE_CREATOR_PLUS=price_REPLACE_ME
STRIPE_PRICE_CREATOR_PRO=price_REPLACE_ME
STRIPE_PRICE_EXECUTIVE=price_REPLACE_ME

# Top-up one-time prices
STRIPE_PRICE_TOPUP_5=price_REPLACE_ME
STRIPE_PRICE_TOPUP_10=price_REPLACE_ME
STRIPE_PRICE_TOPUP_25=price_REPLACE_ME

# ---------- Frontend ----------
VITE_BILLING_API_BASE=http://localhost:3000
VITE_ACCOUNT_API_BASE=http://localhost:3000
VITE_UNIFIED_ACCOUNT_ENABLED=false
VITE_GEMINI_METER_MARKUP=3

# Raw model rates per 1K tokens (USD), used for estimate + meter transparency
VITE_GEMINI_RATE_FLASH_IN_1K=0.00035
VITE_GEMINI_RATE_FLASH_OUT_1K=0.00105
VITE_GEMINI_RATE_PRO_IN_1K=0.0035
VITE_GEMINI_RATE_PRO_OUT_1K=0.0105
