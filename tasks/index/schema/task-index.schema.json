{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewtube://schemas/task-index-manifest-v1",
  "title": "ViewTube Task Index VNext Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "authority",
    "nextTaskId",
    "migrationState",
    "taskCount",
    "modules"
  ],
  "properties": {
    "schemaVersion": {
      "const": "viewtube.task-index-manifest.v1"
    },
    "authority": {
      "const": "tasks/index/index.json + tasks/index/shards/*.json"
    },
    "nextTaskId": {
      "type": "string",
      "pattern": "^vt-[0-9]{4,}$"
    },
    "migrationState": {
      "type": "string"
    },
    "taskCount": {
      "type": "integer",
      "minimum": 0
    },
    "modules": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
