docs/
_quarantine/
_migration_hub/
sources/
WORKTREE_TRIAGE_MANIFEST.md
public/html_hub/
public/standalone-html/
public/editors/
public/*.html
!public/oauth-callback.html
src/archive/
src/standalone/
src/generated/
src/fix_*.py
src/remove_subtoolbox*.py

