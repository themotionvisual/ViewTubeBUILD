# Ignore everything in the root by default to keep the repo absolutely pristine
/*

# -------------------------------------------------------------------
# ALLOW-LIST: Only these essential files and directories are tracked
# -------------------------------------------------------------------

# Essential root directories for the application to run and build
!/src/
!/public/
!/ui/
!/server/
!/api/
!/scripts/
!/tests/
!/.github/
!/governance/

# Essential root configuration files
!/package.json
!/package-lock.json
!/vite.config.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/eslint.config.js
!/index.html
!/.gitignore
!/README.md
!/.env.billing.example
!/.vercelignore
!/skills-lock.json

# -------------------------------------------------------------------
# IGNORE-LIST: Standard ignores within the allowed directories
# -------------------------------------------------------------------

# Build output
dist/
build/
out/
coverage/
.vite/
.vt-e1-render/

# Dependencies
node_modules/

