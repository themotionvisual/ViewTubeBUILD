{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewtube://schemas/conversation-work-log",
  "title": "ViewTube Conversation Work Log",
  "type": "object",
  "required": [
    "schemaVersion",
    "conversationId",
    "created",
    "lastEdited",
    "reviewStatus",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "viewtube.conversation-work-log.v1"
    },
    "conversationId": {
      "type": "string",
      "pattern": "^VT-CONV-"
    },
    "created": {
      "type": "string"
    },
    "lastEdited": {
      "type": "string"
    },
    "sourceHost": {
      "type": [
        "string",
        "null"
      ]
    },
    "reviewStatus": {
      "enum": [
        "UNREVIEWED",
        "REVIEWING",
        "PARTIALLY_RECONCILED",
        "RECONCILED"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "title",
          "kind",
          "conversationState",
          "reviewStatus"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "pattern": "^VT-CWI-"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "details": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "FEATURE",
              "BUG",
              "INTEGRATION",
              "REFACTOR",
              "OPTIMIZATION",
              "DESIGN",
              "PLAN",
              "AUDIT",
              "REPORT",
              "DOCUMENTATION",
              "SKILL",
              "WORKFLOW",
              "PROTOTYPE",
              "STANDALONE_HTML",
              "RESEARCH",
              "REFERENCE",
              "MIGRATION",
              "VERIFICATION",
              "CLEANUP",
              "IDEA",
              "RISK",
              "DECISION"
            ]
          },
          "conversationState": {
            "enum": [
              "PLANNED",
              "STARTED",
              "PARTIAL",
              "COMPLETED_IN_CONVERSATION",
              "VERIFIED_IN_CONVERSATION",
              "BLOCKED",
              "ABANDONED",
              "DISCOVERED"
            ]
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilityIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "changedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "branchPrRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "similarityKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "value": {
            "type": "object",
            "properties": {
              "creatorImpact": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "systemLeverage": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "urgency": {
                "enum": [
                  "NONE",
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "CRITICAL"
                ]
              },
              "reusePotential": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "confidence": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH"
                ]
              },
              "estimatedEffort": {
                "enum": [
                  "SMALL",
                  "MEDIUM",
                  "LARGE",
                  "UNKNOWN"
                ]
              },
              "implementationRisk": {
                "enum": [
                  "LOW",
                  "MEDIUM",
                  "HIGH",
                  "UNKNOWN"
                ]
              },
              "rationale": {
                "type": "string"
              }
            },
            "additionalProperties": true
          },
          "relationship": {
            "enum": [
              "NEW",
              "CONTINUATION",
              "ALREADY_TRACKED",
              "DUPLICATE",
              "OVERLAPS",
              "EXPANDS",
              "SUPERSEDES",
              "BUG_IN_EXISTING",
              "VERIFICATION_ONLY",
              "COMPLETED_ALREADY",
              "DONOR_ONLY"
            ]
          },
          "suggestedDestination": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewStatus": {
            "enum": [
              "UNREVIEWED",
              "REVIEWING",
              "RECONCILED"
            ]
          },
          "disposition": {
            "enum": [
              "ALREADY_TRACKED",
              "MERGE_INTO_EXISTING_TASK",
              "CREATE_TASK_CANDIDATE",
              "UPDATE_INTEGRATED_APPLICATION_PROGRAM",
              "UPDATE_PRODUCT_ARCHITECTURE",
              "UPDATE_DOMAIN_AUTHORITY",
              "UPDATE_SPECIFICATION",
              "UPDATE_EXISTING_PLAN",
              "MERGE_PLANS",
              "CREATE_PLAN",
              "CREATE_DECISION_RECORD",
              "CREATE_OPPORTUNITY",
              "CREATE_RISK",
              "ATTACH_RECEIPT_EVIDENCE",
              "ARCHIVE_AS_DONOR",
              "NO_ACTION_REQUIRED",
              "REJECT",
              null
            ]
          },
          "targetRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "harvestedMaterial": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewNotes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
