{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewtube://schemas/consolidation-manifest",
  "title": "ViewTube Consolidation Manifest",
  "type": "object",
  "required": [
    "familyId",
    "title",
    "created",
    "target",
    "sources",
    "accounting",
    "verification"
  ],
  "properties": {
    "familyId": {
      "type": "string",
      "pattern": "^CONSOL-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date"
    },
    "target": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "hash",
          "classification"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          },
          "classification": {
            "type": "string"
          },
          "sourceCommit": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourcePr": {
            "type": [
              "integer",
              "null"
            ]
          },
          "archivedPath": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "accounting": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "kind",
          "summary",
          "disposition"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "TEXT",
              "CODE",
              "CSS",
              "JS",
              "JSON",
              "DATA",
              "COMMENT",
              "INSTRUCTION",
              "REFERENCE",
              "TASK",
              "DECISION",
              "ASSET",
              "BEHAVIOR",
              "CONFLICT",
              "OTHER"
            ]
          },
          "summary": {
            "type": "string"
          },
          "disposition": {
            "enum": [
              "INCORPORATED",
              "TASK_INDEX",
              "DECISION_RECORD",
              "REFERENCE",
              "ARCHIVED_ONLY",
              "SUPERSEDED",
              "CONFLICT_REQUIRES_DECISION"
            ]
          },
          "destination": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "allSourcesArchived",
        "allUniqueMaterialAccounted",
        "inboundReferencesChecked"
      ],
      "properties": {
        "allSourcesArchived": {
          "type": "boolean"
        },
        "allUniqueMaterialAccounted": {
          "type": "boolean"
        },
        "inboundReferencesChecked": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": true
}
